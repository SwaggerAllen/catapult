<?xml version="1.0" encoding="UTF-8"?>
<!--
  impl — one per subcomponent (per(subcomparch)). Unphased: the total end
  state of the subcomponent's implementation, not a per-ticket slice (v5
  §6). <tests> is normative (dsl-syntax.md §10, v5 §2.8): named test
  descriptions are reconciliation's acceptance criteria, so this is the
  one element every impl doc must not skip.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="TestEntry">
    <xs:sequence>
      <xs:element name="acceptance" type="xs:string"/>          <!--
             what passing this test demonstrates, in the reader's terms —
             reconciliation checks the named test exists and passes, not
             that this prose is honored, so the name and the acceptance
             text are what a human is trusting -->
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>  <!--
           the literal ExUnit test name/description this maps to -->
    <xs:attribute name="kind" use="optional" default="example">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="example"/>
          <xs:enumeration value="property"/>                     <!--
                 required alongside example for the ES store family
                 (v5 §2.4): replay-determinism, idempotency,
                 round-trip -->
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:element name="impl">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="summary" type="xs:string"/>
        <xs:element name="approach" type="xs:string"/>            <!--
               the implementation notes proper: data flow, algorithms,
               integration points within the subcomponent's own privapi
               and its dependencies' pubapis -->
        <xs:element name="tests">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="test" type="TestEntry"
                          minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
