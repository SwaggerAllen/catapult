<?xml version="1.0" encoding="UTF-8"?>
<!--
  v4 §1.3 (seed-docs/siege-prompts/sysarch.md), with the
  domain/presentational split and <domain-parent> section dropped —
  v5 §4.1 replaces that mechanism with the product/backend/frontend
  split (seed-docs/README.md's second known delta); every component
  this tier mints is simply a component. <foundation/> and the
  four-child order (techspec -> components -> policies -> dependencies)
  otherwise carry forward unchanged.

  Each <policy> may carry <required> (scopes through a resp — the
  policy_application edge's policy->resp instance) *or* <structural/>
  (scopes directly to the declaring comp — policy_application's
  policy->comp instance) *or* neither (project-global, no scope edge)
  — never both; enforced by the xs:choice below, not
  by a boolean flag, so the grammar itself rules out declaring both
  grains on one policy. New relative to siege's <required>-only
  grammar (v5 §4.5's third grain).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="Techspec">
    <xs:sequence>
      <xs:element name="runtime" type="xs:string"/>
      <xs:element name="persistence" type="xs:string"/>
      <xs:element name="write-path" type="xs:string"/>
      <xs:element name="concurrency" type="xs:string"/>
      <xs:element name="testing" type="xs:string"/>
      <xs:element name="deploy" type="xs:string"/>
      <xs:element name="technologies" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Invariants">
    <xs:sequence>
      <xs:element name="invariant" type="xs:string" minOccurs="2" maxOccurs="4"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Operations">
    <xs:sequence>
      <xs:element name="operation" type="xs:string" minOccurs="3" maxOccurs="6"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RespRefs">
    <xs:sequence>
      <xs:element name="resp" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="id" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Component">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="purpose" type="xs:string"/>
      <xs:element name="owned-invariants" type="Invariants"/>
      <xs:element name="primary-operations" type="Operations"/>
      <xs:element name="responsibilities" type="RespRefs"/>
      <xs:element name="foundation" minOccurs="0" maxOccurs="1">
        <xs:complexType/>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="alias" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="Components">
    <xs:sequence>
      <xs:element name="component" type="Component" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Policy">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="trigger" type="xs:string"/>
      <xs:choice minOccurs="0" maxOccurs="1">
        <xs:element name="required" type="xs:string"/>
        <xs:element name="structural">
          <xs:complexType/>
        </xs:element>
      </xs:choice>
      <xs:element name="rationale" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Policies">
    <xs:sequence>
      <xs:element name="policy" type="Policy" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Dep">
    <xs:attribute name="from" type="xs:string" use="required"/>
    <xs:attribute name="to" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="Dependencies">
    <xs:sequence>
      <xs:element name="dep" type="Dep" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="sysarch">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="introduction" type="xs:string" minOccurs="0"/>
        <xs:element name="techspec" type="Techspec"/>
        <xs:element name="components" type="Components"/>
        <xs:element name="policies" type="Policies"/>
        <xs:element name="dependencies" type="Dependencies"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
