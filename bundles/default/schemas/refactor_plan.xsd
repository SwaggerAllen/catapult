<?xml version="1.0" encoding="UTF-8"?>
<!-- The refactor flow's planning-tier grammar. No siege source (this
     flow predates siege's own prompt corpus at this bundle's fidelity,
     and only prose describes it, with no shipped prompt) — kept
     intentionally small. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="refactor-plan">
    <xs:complexType>
      <xs:sequence>
        <!-- The ticket surface's own headline (ORC-114, docs/dsl-syntax.md
             §3's reserved `argument` fields: name) — one or two sentences,
             why this work exists, not a restatement of <rationale>. -->
        <xs:element name="argument" type="xs:string"/>
        <xs:element name="scope" type="xs:string"/>
        <xs:element name="rationale" type="xs:string"/>
        <xs:element name="resolved" type="xs:boolean"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
