<?xml version="1.0" encoding="UTF-8"?>
<!--
  New tier, no siege precedent — v5 §5.3's minting rules. Mints both
  collection families in one pass: `<ui-collections>` (backend comps,
  journeys, and recurrence across screen definitions as the three
  seeding signals — v5 §5.3) and `<screen-collections>` (grouped by IA
  region — shared layout shell, auth context, navigation neighbourhood
  — journeys are a signal into this grouping, never a gate on it).
  chain.yaml's `decomposition` edge's frontend_sysarch->ui_coll and
  frontend_sysarch->screen_coll instances mint one node per
  `<collection>` row in each block.

  `<ui-dependencies>`/`<screen-dependencies>` are the project-wide
  same-tier `dependency` edge's instances (ui_coll<->ui_coll,
  screen_coll<->screen_coll), declared here rather than per-collarch
  for the same reason comp<->comp is declared in sysarch's own draft
  rather than comparch's: this is the one pass that sees every minted
  collection at once. Each `<screen-collections>/<collection>`'s own
  `<screens>` block is the formal `fulfills` `screen_coll -> screen`
  instance ("hosts", chain.yaml's `fulfills` edge) — declared here, at
  mint time, since the same pass that groups screens into collections
  is the one naming which screens land in which collection.

  `<ui-collections>/<collection>`'s own `<uses-shapes>` and
  `<screen-collections>/<collection>`'s own `<renders>`/`<calls>` are
  ORC-235's relocation of three more edges here, off `ui_collarch`'s
  and `screen_collarch`'s own drafts (`systems/platform_content.md`'s
  ORC-235 entry): a UI or screen collection's backend/cross-family
  dependencies are this pass's own decision, the identical reasoning
  `<ui-dependencies>`/`<screen-dependencies>` above already state for
  the same-family case, not a fact `ui_collarch`/`screen_collarch` can
  declare about themselves before this pass has run. `uses_shapes`/
  `calls` target real, already-minted backend `comp` nodes (`ref=`, a
  global id, the same shape `<screens>/<screen ref=.../>` above already
  uses for an already-minted node); `renders` targets a `ui_coll` this
  same draft is minting, so it names the local `<ui-collections>`
  alias instead (`to=`, the same local-alias shape
  `<ui-dependencies>`/`<screen-dependencies>` already use for a
  same-draft target with no global id yet).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:catapult="urn:catapult:dsl">

  <xs:complexType name="CompRefs">
    <xs:sequence>
      <xs:element name="comp" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="ref" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Mints `ui_coll`, identified by `alias` (ORC-246's same fix as
       `comp`: the retired chain.yaml declared `identity: id`, which
       named no attribute this type actually carries). -->
  <xs:complexType name="UiCollection">
    <xs:annotation><xs:appinfo><catapult:mints tier="ui_coll" identity="alias"/></xs:appinfo></xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="xs:string">
        <xs:annotation><xs:appinfo><catapult:field name="name"/></xs:appinfo></xs:annotation>
      </xs:element>
      <xs:element name="purpose" type="xs:string">
        <xs:annotation><xs:appinfo><catapult:field name="purpose"/></xs:appinfo></xs:annotation>
      </xs:element>
      <xs:element name="uses-shapes" type="CompRefs" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="alias" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="UiCollections">
    <xs:sequence>
      <xs:element name="collection" type="UiCollection" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Dep">
    <xs:attribute name="from" type="xs:string" use="required"/>
    <xs:attribute name="to" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="Dependencies">
    <xs:sequence>
      <xs:element name="dep" type="Dep" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Local-alias-only targets, no `from` — the enclosing `<collection>`
       is always the source, the same reason `<ui-collections>/
       <collection>`'s own `<uses-shapes>` needs no `from` either. -->
  <xs:complexType name="AliasRefs">
    <xs:sequence>
      <xs:element name="dep" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="to" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ScreenRefs">
    <xs:sequence>
      <xs:element name="screen" minOccurs="1" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="ref" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Mints `screen_coll`, identified by `alias` (same ORC-246 fix). -->
  <xs:complexType name="ScreenCollection">
    <xs:annotation><xs:appinfo><catapult:mints tier="screen_coll" identity="alias"/></xs:appinfo></xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="xs:string">
        <xs:annotation><xs:appinfo><catapult:field name="name"/></xs:appinfo></xs:annotation>
      </xs:element>
      <xs:element name="purpose" type="xs:string">
        <xs:annotation><xs:appinfo><catapult:field name="purpose"/></xs:appinfo></xs:annotation>
      </xs:element>
      <xs:element name="ia-region" type="xs:string">
        <xs:annotation><xs:appinfo><catapult:field name="ia_region"/></xs:appinfo></xs:annotation>
      </xs:element>
      <xs:element name="screens" type="ScreenRefs"/>
      <xs:element name="renders" type="AliasRefs" minOccurs="0"/>
      <xs:element name="calls" type="CompRefs" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="alias" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="ScreenCollections">
    <xs:sequence>
      <xs:element name="collection" type="ScreenCollection" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="frontend-sysarch">
    <xs:annotation><xs:appinfo><catapult:identity>id</catapult:identity></xs:appinfo></xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="introduction" type="xs:string" minOccurs="0">
          <xs:annotation><xs:appinfo><catapult:field name="intro"/></xs:appinfo></xs:annotation>
        </xs:element>
        <xs:element name="ui-collections" type="UiCollections"/>
        <xs:element name="ui-dependencies" type="Dependencies"/>
        <xs:element name="screen-collections" type="ScreenCollections"/>
        <xs:element name="screen-dependencies" type="Dependencies"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
