<?xml version="1.0" encoding="UTF-8"?>
<!--
  No siege source — v5 §5.1-§5.4, authored fresh. Mirrors
  subcomparch.xsd: only three fragment-bearing sections (technical-
  specification, public-surface, private-surface — the same 5-then-3
  fragment-ownership split ORC-84 settled for the backend pair), a
  process inventory (v5 §2.5/§6, the same general named-process
  doctrine subcomparch.xsd already carries — nothing about it is
  backend-specific), and dependencies on sibling `ui_subcomp` ids
  (the `dependency` edge's own ui_subcomp<->ui_subcomp instance,
  edges/dependency.yaml) rather than sibling comp ids.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="Dependencies">
    <xs:sequence>
      <xs:element name="dep" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="to" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="ProcessCategory">
    <xs:restriction base="xs:string">
      <xs:enumeration value="local"/>
      <xs:enumeration value="singleton"/>
      <xs:enumeration value="sharded"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Guardrails">
    <xs:sequence>
      <xs:element name="max-heap-size" type="xs:string" minOccurs="0"/>
      <xs:element name="message-queue-bound" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Process">
    <xs:sequence>
      <xs:element name="category" type="ProcessCategory"/>
      <xs:element name="purpose" type="xs:string"/>
      <xs:element name="guardrails" type="Guardrails" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="Processes">
    <xs:sequence>
      <xs:element name="process" type="Process" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="References">
    <xs:sequence>
      <xs:element name="reference" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="target" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="ui-subcomparch">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="technical-specification" type="xs:string"/>
        <xs:element name="public-surface" type="xs:string"/>
        <xs:element name="private-surface" type="xs:string"/>
        <xs:element name="processes" type="Processes"/>
        <xs:element name="dependencies" type="Dependencies"/>
        <xs:element name="references" type="References" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
