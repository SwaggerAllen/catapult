<?xml version="1.0" encoding="UTF-8"?>
<!--
  No siege source — v5 §5.1-§5.4, authored fresh. Mirrors comparch.xsd
  the same way ui_collarch.xsd does, with the backend-specific
  machinery dropped (no `<permissions>`/`<enforcement>`, no `<owns>`
  resp/feat claims — a screen collection fulfills no resp either, its
  `fulfills` edge targets `screen`, edges/fulfills.yaml). `<renders>`
  carries the `renders` edge's UI-collection targets; `<dependencies>`
  carries the `calls` edge's backend-comp targets — screen collections
  own all `calls` edges (v5 §5.4); `<journeys>` carries the
  `reference` edge's `screen_coll -> journey` instance ("consumes
  journey state"). Which screens this collection hosts is not declared
  here — that is `frontend_sysarch`'s own `fulfills` instance,
  declared at mint time (schemas/frontend_sysarch.xsd), since the pass
  that groups screens into collections is the one that names them.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="Invariants">
    <xs:sequence>
      <xs:element name="invariant" type="xs:string" minOccurs="2" maxOccurs="4"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Operations">
    <xs:sequence>
      <xs:element name="operation" type="xs:string" minOccurs="3" maxOccurs="6"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Targets">
    <xs:sequence>
      <xs:element name="dep" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="to" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="JourneyRefs">
    <xs:sequence>
      <xs:element name="journey" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="ref" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="ImplementationGrade">
    <xs:restriction base="xs:string">
      <xs:enumeration value="real"/>
      <xs:enumeration value="stubbed"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="Swap">
    <xs:restriction base="xs:string">
      <xs:enumeration value="transparent"/>
      <xs:enumeration value="migration"/>
      <xs:enumeration value="reset"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- swap/exit-plan required iff grade="stubbed" — cross-field rule
       left to instance-level validation (dsl-syntax.md §13). -->
  <xs:complexType name="Implementation">
    <xs:sequence>
      <xs:element name="swap" type="Swap" minOccurs="0"/>
      <xs:element name="exit-plan" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="grade" type="ImplementationGrade" use="required"/>
  </xs:complexType>

  <xs:complexType name="Subcomponent">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="purpose" type="xs:string"/>
      <xs:element name="owned-invariants" type="Invariants"/>
      <xs:element name="primary-operations" type="Operations"/>
      <xs:element name="responsibilities" type="xs:string"/>
      <xs:element name="implementation" type="Implementation"/>
    </xs:sequence>
    <xs:attribute name="alias" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="Subcomponents">
    <xs:sequence>
      <xs:element name="subcomponent" type="Subcomponent" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SubDependencies">
    <xs:sequence>
      <xs:element name="dep" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="from" type="xs:string" use="required"/>
          <xs:attribute name="to" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="References">
    <xs:sequence>
      <xs:element name="reference" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:attribute name="target" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="screen-collarch">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="technical-specification" type="xs:string"/>
        <xs:element name="public-surface" type="xs:string"/>
        <xs:element name="private-surface" type="xs:string"/>
        <xs:element name="failure-surface" type="xs:string"/>
        <xs:element name="policies" type="xs:string"/>
        <xs:element name="renders" type="Targets"/>
        <xs:element name="dependencies" type="Targets"/>
        <xs:element name="journeys" type="JourneyRefs" minOccurs="0"/>
        <xs:element name="subcomponents" type="Subcomponents"/>
        <xs:element name="sub-dependencies" type="SubDependencies"/>
        <xs:element name="references" type="References" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
