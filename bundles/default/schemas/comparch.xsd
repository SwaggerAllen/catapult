<?xml version="1.0" encoding="UTF-8"?>
<!--
  comparch — one per domain-kind component (child_of(resp), scope_filter:
  is_domain). The v5 grammar growth named in dsl-syntax.md §10 and
  v5-design-decisions.md §6 lands here: <permissions>, <enforcement>, and
  a per-scope <implementation> (stub grade, v5 §2.16).

  Fields (bundles/default/tiers/comparch.yaml) read name/kind off the root
  element's attributes and techspec off the <techspec> element; produces:
  writes techspec/pubapi/privapi/failure_surface fragments verbatim from
  the like-named elements — so those four element names are load-bearing,
  not just documentation.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:simpleType name="ImplementationGrade">
    <xs:restriction base="xs:string">
      <xs:enumeration value="stubbed"/>
      <xs:enumeration value="real"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SwapPlan">
    <xs:restriction base="xs:string">
      <xs:enumeration value="transparent"/>
      <xs:enumeration value="migration"/>
      <xs:enumeration value="reset"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProcessCategory">
    <xs:restriction base="xs:string">
      <xs:enumeration value="local"/>
      <xs:enumeration value="singleton"/>
      <xs:enumeration value="sharded"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Present at comparch grain when the whole component's boundary is
       gated (the founding case, v5 §2.16: crypto core awaiting review);
       a component that is fully real omits it. -->
  <xs:complexType name="Implementation">
    <xs:sequence>
      <xs:element name="deferral_argument" type="xs:string"/>
      <xs:element name="exit_data_plan" type="xs:string" minOccurs="0"/>  <!--
             required in practice whenever swap is not "transparent"; the
             loader is what enforces that cross-field rule, not the XSD -->
    </xs:sequence>
    <xs:attribute name="grade" type="ImplementationGrade" use="required"/>
    <xs:attribute name="swap" type="SwapPlan" use="required"/>
  </xs:complexType>

  <xs:complexType name="Permission">
    <xs:sequence>
      <xs:element name="description" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="atom" type="xs:string" use="required"/>  <!--
           the compile-time atom permissions/0 declares; this block is the
           design-tier standing decision, the function->permission->role
           matrix is generated elsewhere (v5 §2.9) and never restated here -->
  </xs:complexType>

  <xs:simpleType name="EnforcementProfile">
    <xs:restriction base="xs:string">
      <!-- platform-defined enforcement profiles (v5 §6, §9) — a closed,
           extension-registered vocabulary; comparch only names one -->
      <xs:enumeration value="codegen:restricted"/>
      <xs:enumeration value="purity:replay_floor"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="EnforcementEntry">
    <xs:attribute name="profile" type="EnforcementProfile" use="required"/>
    <xs:attribute name="scope" type="xs:string" use="optional"/>  <!--
           omitted = whole component; a subcomponent slug narrows it -->
  </xs:complexType>

  <xs:complexType name="Subcomponent">
    <xs:attribute name="slug" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="Dependency">
    <xs:attribute name="to" type="xs:string" use="required"/>       <!--
           target comparch id/slug -->
    <xs:attribute name="consistency" use="optional" default="eventual">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="eventual"/>
          <xs:enumeration value="transactional"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="FulfillsEntry">
    <xs:attribute name="ref" type="xs:string" use="required"/>      <!--
           a responsibility id from resp's <responsibilities> -->
  </xs:complexType>

  <xs:complexType name="ProcessEntry">
    <xs:sequence>
      <xs:element name="max_heap_size" type="xs:string" minOccurs="0"/>
      <xs:element name="message_queue_alarm_len" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="category" type="ProcessCategory" use="required"/>
  </xs:complexType>

  <xs:element name="comparch">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fulfills">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="responsibility" type="FulfillsEntry"
                          minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="techspec" type="xs:string"/>
        <xs:element name="pubapi" type="xs:string"/>
        <xs:element name="privapi" type="xs:string" minOccurs="0"/>   <!--
               component-level internal surface shared across the
               component's own subcomponents; the finer-grained
               subcomponent-to-subcomponent surface lives on subcomparch -->
        <xs:element name="failure_surface" type="xs:string"/>
        <xs:element name="permissions" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="permission" type="Permission"
                          minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="enforcement" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="entry" type="EnforcementEntry"
                          minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="processes" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="process" type="ProcessEntry"
                          minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="implementation" type="Implementation" minOccurs="0"/>
        <xs:element name="subcomponents">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="subcomponent" type="Subcomponent"
                          minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="dependencies" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="dependency" type="Dependency"
                          minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="kind" type="xs:string" use="required"/>   <!--
             restated from resp's <component kind="..."/> so comparch's
             own fields: (kind: draft.@kind) needs no upstream hop -->
    </xs:complexType>
  </xs:element>

</xs:schema>
