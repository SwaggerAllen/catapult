    "mix deps.audit",
    "mix xref graph --format cycles --fail-above 0",
    "mix xref graph --label compile-connected --fail-above 0",
    "mix catapult.audit.all",
    "mix test"
  ],
  "deploy": {
    "provider": "digitalocean",
